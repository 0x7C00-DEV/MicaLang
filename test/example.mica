interface IShape {
    fn area(): double;
}

class Circle {
    r: double;
    fn __init__(self: Circle, r: double): void {
        self.r = r;
    }
    fn area(self: Circle): double {
        return 3.14 * self.r * self.r;
    }
}

fn takeShape(x: IShape): void { }

fn main(): int {
    let c = new Circle(1.0);
    takeShape(c);
    return 0;
}