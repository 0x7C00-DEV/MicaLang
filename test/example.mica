class Test {
    x: int;
    fn __init__(self: Test, x: int): void {
        self.x = x;
    }

    fn showX(self: Test): void {
        println(itos(self.x));
    }

    fn __add__(self: Test, y: int): Test {
        return new Test(self.x + y);
    }

    fn __elementget__(self: Test, value: int): int {
        return self.x + value;
    }
}

fn main(): int {
    let tmp = new Test(12);
    println(itos(tmp[9]));
    return 0;
}