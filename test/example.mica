class Parent {
    fn __init__(self: Parent): void {

    }

    fn show(self: Parent): void {
        println("hello, world");
    }
}

class Children extend Parent {
    fn __init__(self: Children): void {
        self.show();
    }

    fn operator[](self: Children, pos: int): int {
        return pos*12;
    }
}

fn main(): void {
    let tmp = new Children();
    println(itos(tmp[1]));
}