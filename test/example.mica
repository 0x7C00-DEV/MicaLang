interface Show {
    fn asString():str;
}


class A implement Show {
    msg: str;
    fn __init__(self: A, msg: str): void {
        self.msg = msg;
    }

    fn operator()(self: A, b: str): void {
        println("called!");
        println(b);
        println(self.msg);
    }

    fn show(self: A): void {
        println(self.msg);
    }

    fn test(): void {
        println("hello, world");
    }

    fn asString(self: A) : str {
        return self.msg;
    }
}



fn main(): int {
    let tmp = new A("hello, world");
    tmp("1");
    tmp.show();
    A.test();
}