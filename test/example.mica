class Test {
    x: [int];
    fn __init__(self: Test): void {
        self.x = [0,0,0,0,0,0];
    }

    fn operator[](self: Test, pos:int, val: int): void {
        self.x[pos] = val;
    }

    fn operator[](self: Test, pos:int): int {
        return self.x[pos];
    }

    fn showX(self: Test): void {
        println(itos(self.x[0]));
    }

    fn test(): void {
        println("hello, world");
    }
}

fn change(x:[int]): void {
    x[0] = 12;
}

fn main(): int {
    let tmp = new Test();
    tmp[0] = 12;
    tmp.showX();
    println(itos(tmp[0]));
    Test.test();
    return 0;
}