class Test {
    x: [int];
    fn __init__(self: Test): void {
        self.x = [0,0,0,0,0,0];
    }

    fn operator[](self: Test, pos:int, val: int): void {
        self.x[pos] = val;
    }

    fn operator[](self: Test, pos:int): int {
        return self.x[pos];
    }
}

fn main(): int {
    let tmp = new Test();
    tmp[0] = 12;
    println(itos(tmp[0]));
    return 0;
}