class Test {
    x: [int];
    fn __init__(self: Test): void {
        self.x = [0,0,0,0,0,0];
    }

    fn operator[](self: Test, pos:int, val: int): void {
        self.x[pos] = val;
    }

    fn operator[](self: Test, pos:int): int {
        return self.x[pos];
    }
}

fn main(): int {
    let x = 0;
    x += 1;
    println(itos(x));
    return 0;
}